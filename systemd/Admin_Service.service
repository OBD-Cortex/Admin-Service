[Unit]
Description=OBD-Cortex Admin Service (FastAPI)
After=network.target

[Service]
User=admin-service
Group=admin-service
WorkingDirectory=/home/admin-service/Admin_Service
Environment="PATH=/home/admin-service/Admin_Service/venv/bin"
ExecStart=/home/admin-service/Admin_Service/venv/bin/uvicorn main_api:app --app-dir src --host 127.0.0.1 --port 8000 --workers 2

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
