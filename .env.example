# Your MongoDB Atlas Connection String
# How to fill: Replace user, pass, and cluster.mongodb.net with your actual MongoDB Atlas connection details.
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# JWT HS256 Shared Secret for secure Server-to-Server Admin Dashboard communication
# How to fill: Generate a secure 32-character or 32-byte hexadecimal string (e.g., using `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"`)
# This secret must be identical to the one configured in the Admin-Dashboard.
ADMIN_JWT_SECRET=your_32_byte_hex_secret_here

# Comma-separated list of allowed CORS origins
# How to fill: Provide a comma-separated list of allowed client origins. Do NOT use "*" in production.
# Example: CORS_ORIGINS=https://admin.yourdomain.com
CORS_ORIGINS=

